<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/hira_tiako_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp">

    <!-- 1. TOP FLOATING PILL CAPSULE HEADER -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:paddingBottom="8dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface_container_lowest"
            app:cardCornerRadius="999dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/border_eae0e2"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="8dp"
                android:paddingEnd="10dp"
                android:paddingBottom="8dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_hira_tiako_back"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/hikaroka_pill_bg"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:rippleColor="@color/border_eae0e2">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_gravity="center"
                        android:contentDescription="Hiverina"
                        android:src="@drawable/ic_arrow_back"
                        app:tint="@color/primary_container" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tv_hira_tiako_header_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:gravity="center"
                    android:letterSpacing="-0.01"
                    android:text="HIRA TIAKO"
                    android:textAllCaps="true"
                    android:textColor="@color/primary_container"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_hira_tiako_top_fav"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/hikaroka_pill_bg"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:rippleColor="@color/border_eae0e2">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_gravity="center"
                        android:contentDescription="Hira tiako"
                        android:src="@drawable/ic_heart"
                        app:tint="@color/primary_container" />
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <!-- SUBTITLE INFO PILL & 3 FILTER CHIPS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:orientation="vertical">

        <!-- Info Banner Pill: "Ireo hira ankafizina manokana ao amin'ny fihirana" -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_hira_tiako_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/surface_container_lowest"
            app:cardCornerRadius="999dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/border_eae0e2"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_bookmark_heart"
                    app:tint="@color/primary_container" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:gravity="center"
                    android:text="Ireo hira ankafizina manokana ao amin'ny fihirana"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3 Filter Chips Capsule (Rehetra / Fihirana lehibe / Fanampiny) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface_container_lowest"
            app:cardCornerRadius="999dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/border_eae0e2"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="4dp">

                <!-- Chip 1: Rehetra -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/chip_fav_all"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="2dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/chip_active_bg"
                    app:cardCornerRadius="999dp"
                    app:cardElevation="0dp"
                    app:rippleColor="@color/hikaroka_pill_bg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp">

                        <ImageView
                            android:id="@+id/icon_fav_chip_all"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_auto_stories"
                            app:tint="@color/white" />

                        <TextView
                            android:id="@+id/tv_fav_chip_all"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:maxLines="1"
                            android:text="Rehetra"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Chip 2: Fihirana lehibe -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/chip_fav_lehibe"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="999dp"
                    app:cardElevation="0dp"
                    app:rippleColor="@color/hikaroka_pill_bg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp">

                        <ImageView
                            android:id="@+id/icon_fav_chip_lehibe"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_music_note"
                            app:tint="@color/chip_active_bg" />

                        <TextView
                            android:id="@+id/tv_fav_chip_lehibe"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:maxLines="1"
                            android:text="Fihirana lehibe"
                            android:textColor="@color/chip_active_bg"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Chip 3: Fanampiny -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/chip_fav_fanampiny"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="2dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="999dp"
                    app:cardElevation="0dp"
                    app:rippleColor="@color/hikaroka_pill_bg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp">

                        <ImageView
                            android:id="@+id/icon_fav_chip_fanampiny"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_queue_music"
                            app:tint="@color/chip_active_bg" />

                        <TextView
                            android:id="@+id/tv_fav_chip_fanampiny"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:maxLines="1"
                            android:text="Fanampiny"
                            android:textColor="@color/chip_active_bg"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- 2. SUB-HEADER / SUMMARY PILL & QUICK METRICS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="6dp"
            android:layout_height="16dp"
            android:background="@drawable/bg_section_indicator" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="@font/plus_jakarta_sans"
            android:letterSpacing="0.06"
            android:text="LISITRA VOATAHIRY"
            android:textAllCaps="true"
            android:textColor="#44403C"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface_container_lowest"
            app:cardCornerRadius="999dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/border_eae0e2"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_heart"
                    app:tint="@color/primary_container" />

                <TextView
                    android:id="@+id/tv_hira_tiako_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="0 hira voatahiry"
                    android:textColor="@color/primary_container"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Empty State Message (only shown if user removes all favorites) -->
    <TextView
        android:id="@+id/tv_empty_favorites"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:fontFamily="@font/inter"
        android:gravity="center"
        android:text="Tsy mbola misy hira voatahiry ao amin'ny Hira Tiako."
        android:textColor="@color/on_surface_variant"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- 3. FAVORITES LIST (iOS 18 Solid Bento Cards List) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_favorite_songs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="108dp" />

</LinearLayout>
