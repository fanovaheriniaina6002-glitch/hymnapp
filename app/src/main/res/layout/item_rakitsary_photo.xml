<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_rakitsary_item"
    android:layout_width="match_parent"
    android:layout_height="216dp"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/surface_container_lowest"
    app:cardCornerRadius="22dp"
    app:cardElevation="2dp"
    app:rippleColor="#33FFFFFF"
    app:strokeColor="#CCFFFFFF"
    app:strokeWidth="1dp">

    <FrameLayout
        android:id="@+id/photo_item_click_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true">

        <!-- Full-Card Archival Photograph -->
        <ImageView
            android:id="@+id/iv_photo_thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_archive_1_gathering" />

        <!-- Top-Left Solid Category Badge -->
        <TextView
            android:id="@+id/tv_photo_category_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="10dp"
            android:background="@drawable/bg_badge_dark_pill"
            android:fontFamily="@font/plus_jakarta_sans"
            android:letterSpacing="0.06"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:text="TANTARA"
            android:textAllCaps="true"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Bottom Gradient Scrim & Captions (from-[#781C2E]/95 via-[#781C2E]/60 to-transparent) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_rakitsary_bottom_scrim"
            android:gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="44dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/tv_photo_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/plus_jakarta_sans"
                android:maxLines="1"
                android:text="Fihaonambe 1965"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_photo_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/inter"
                android:maxLines="1"
                android:text="Ankadembahoaka • Foibe"
                android:textColor="@color/white_80"
                android:textSize="11sp" />

            <!-- Hidden compatibility views -->
            <TextView
                android:id="@+id/tv_photo_year"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_photo_location"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>

    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
